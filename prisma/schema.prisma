generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

enum ImageFormat {
  PNG
  JPG
  WEBP
}

enum BackgroundType {
  TRANSPARENT
  WHITE
  COLOR
  GRADIENT
  CUSTOM
  BLUR
  STUDIO
  OFFICE
  NATURE
  ECOMMERCE
}

enum AIProvider {
  REMOVEBG
  CLIPDROP
  PHOTOROOM
  REPLICATE
  CUSTOM
}

enum CreditTransactionType {
  USAGE
  PURCHASE
  BONUS
  REFUND
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  credits       Int       @default(10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  subscription       Subscription?
  images             ProcessedImage[]
  projects           Project[]
  apiKeys            ApiKey[]
  creditTransactions CreditTransaction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProcessedImage {
  id             String         @id @default(cuid())
  userId         String
  originalUrl    String
  processedUrl   String
  thumbnailUrl   String?
  fileName       String
  fileSize       Int
  width          Int
  height         Int
  format         ImageFormat    @default(PNG)
  backgroundType BackgroundType @default(TRANSPARENT)
  provider       AIProvider     @default(REMOVEBG)
  creditsUsed    Int            @default(1)
  projectId      String?
  createdAt      DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ProcessedImage[]

  @@index([userId])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  key       String    @unique
  lastUsed  DateTime?
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model CreditTransaction {
  id          String                @id @default(cuid())
  userId      String
  amount      Int
  type        CreditTransactionType
  description String
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIProviderConfig {
  id       String     @id @default(cuid())
  provider AIProvider @unique
  name     String
  apiKey   String?
  baseUrl  String?
  isActive Boolean    @default(false)
  priority Int        @default(0)
  settings Json       @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}
