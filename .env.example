# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BackgroundAI

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/backgroundai

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe Price IDs
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly
STRIPE_STARTER_ANNUAL_PRICE_ID=price_starter_annual
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_business_monthly
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_business_annual

# AI Providers
REMOVEBG_API_KEY=your-removebg-api-key
CLIPDROP_API_KEY=your-clipdrop-api-key
PHOTOROOM_API_KEY=your-photoroom-api-key
REPLICATE_API_TOKEN=your-replicate-api-token
CUSTOM_MODEL_URL=http://localhost:8080/predict

# Storage (S3-compatible)
S3_BUCKET=backgroundai-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_ENDPOINT=https://s3.amazonaws.com
